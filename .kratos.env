# =====================================================================
# Kratos configuration as environment-variable overrides for kratos.yml.
# Injected into the `kratos` and `kratos-migrate` services via `env_file`.
#
# Every value references a variable from `.env` — Docker Compose interpolates
# them here at `up` time. To change domains / secrets / SMTP, edit `.env`;
# you normally don't touch this file. To override at the command line, set the
# BASE variable (the one in ${...}), not the Kratos key — e.g.
# `KRATOS_CIPHER_SECRET=... docker compose up`, not `SECRETS_CIPHER=...`.
# =====================================================================

DSN=postgres://kratos:${POSTGRES_KRATOS_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/kratos?sslmode=disable

# [PRODUCTION] LOG_LEVEL -> info/warn ; LOG_LEAK_SENSITIVE_VALUES must be false
LOG_LEVEL=warning # [DEBUGGING] set to debug, info or warning
LOG_LEAK_SENSITIVE_VALUES=false # [DEBUGGING] set to true to log sensitive values — NEVER in production

# --- Public / browser-facing URLs (Kratos is reached through the web frontend) ---
SERVE_PUBLIC_BASE_URL=${DEVGUARD_PROTOCOL}://${DEVGUARD_WEB_DOMAIN}/
SELFSERVICE_DEFAULT_BROWSER_RETURN_URL=${DEVGUARD_PROTOCOL}://${DEVGUARD_WEB_DOMAIN}/
SELFSERVICE_ALLOWED_RETURN_URLS=${DEVGUARD_PROTOCOL}://${DEVGUARD_WEB_DOMAIN}

# --- Self-service flow UI URLs (rendered by devguard-web) ---
SELFSERVICE_FLOWS_ERROR_UI_URL=${DEVGUARD_PROTOCOL}://${DEVGUARD_WEB_DOMAIN}/error
SELFSERVICE_FLOWS_SETTINGS_UI_URL=${DEVGUARD_PROTOCOL}://${DEVGUARD_WEB_DOMAIN}/user-settings
SELFSERVICE_FLOWS_RECOVERY_UI_URL=${DEVGUARD_PROTOCOL}://${DEVGUARD_WEB_DOMAIN}/recovery
SELFSERVICE_FLOWS_VERIFICATION_UI_URL=${DEVGUARD_PROTOCOL}://${DEVGUARD_WEB_DOMAIN}/verification
SELFSERVICE_FLOWS_VERIFICATION_AFTER_DEFAULT_BROWSER_RETURN_URL=${DEVGUARD_PROTOCOL}://${DEVGUARD_WEB_DOMAIN}/

# --- Disable email verification & recovery flows (no auto verification email on signup) ---
SELFSERVICE_FLOWS_VERIFICATION_ENABLED=${KRATOS_VERIFICATION_ENABLED}
SELFSERVICE_FLOWS_RECOVERY_ENABLED=${KRATOS_RECOVERY_ENABLED}
SELFSERVICE_FLOWS_LOGOUT_AFTER_DEFAULT_BROWSER_RETURN_URL=${DEVGUARD_PROTOCOL}://${DEVGUARD_WEB_DOMAIN}/login
SELFSERVICE_FLOWS_LOGIN_UI_URL=${DEVGUARD_PROTOCOL}://${DEVGUARD_WEB_DOMAIN}/login
SELFSERVICE_FLOWS_REGISTRATION_UI_URL=${DEVGUARD_PROTOCOL}://${DEVGUARD_WEB_DOMAIN}/registration

# --- Passkey / WebAuthn (RP_ID MUST be the root domain, no scheme/port) ---
SELFSERVICE_METHODS_PASSKEY_CONFIG_RP_ID=${KRATOS_PASSKEY_RP_ID}
SELFSERVICE_METHODS_PASSKEY_CONFIG_RP_ORIGINS=${DEVGUARD_PROTOCOL}://${DEVGUARD_WEB_DOMAIN}

# --- Secrets (single-element lists; the override replaces the whole list) ---
SECRETS_COOKIE=${KRATOS_COOKIE_SECRET}
SECRETS_CIPHER=${KRATOS_CIPHER_SECRET}

# --- Courier / SMTP (mail agent) ---
COURIER_SMTP_CONNECTION_URI=${KRATOS_SMTP_CONNECTION_URI}
COURIER_SMTP_FROM_ADDRESS=${KRATOS_SMTP_FROM_ADDRESS}
COURIER_SMTP_FROM_NAME=${KRATOS_SMTP_FROM_NAME}
