#######################
# Variables to change for production deployment
#######################

DEVGUARD_WEB_DOMAIN=localhost:3000
DEVGUARD_API_DOMAIN=localhost:8080
DEVGUARD_PROTOCOL=http

POSTGRES_DEVGUARD_PASSWORD="change-me"
POSTGRES_KRATOS_PASSWORD="change-me"

# Session/cookie & cipher secrets — generate with: openssl rand -base64 24
KRATOS_COOKIE_SECRET="change-me"
# KRATOS_CIPHER_SECRET MUST be exactly 32 characters.
KRATOS_CIPHER_SECRET="change-me"

# Passkey/WebAuthn relying-party id: the ROOT domain only (no scheme, no port). e.g. if DEVGUARD_WEB_DOMAIN=app.example.com this should be example.com
KRATOS_PASSKEY_RP_ID=${DEVGUARD_WEB_DOMAIN}

# If you enable Verification or Recovery make sure to also set a valid Mail Agent (otherwise you can leave it as is)
KRATOS_VERIFICATION_ENABLED=false
KRATOS_RECOVERY_ENABLED=false
KRATOS_SMTP_CONNECTION_URI="smtps://user:pass@devguard.org:465/" 
KRATOS_SMTP_FROM_ADDRESS=noreply@devguard.org
KRATOS_SMTP_FROM_NAME=DevGuard


#######################
# Docker Image Versions
#######################

DEVGUARD_API_TAG=v1.16.1
DEVGUARD_WEB_TAG=v1.16.2
POSTGRESQL_TAG=16.15
KRATOS_TAG=v26.2.0
TRAEFIK_TAG=v3.7

#######################
# DevGuard
#######################

DEVGUARD_LOG_LEVEL=warn  # set to debug, info or warn
APP_SIDE_ENCRYPTION_KEY_PATH=/keys/app_side_encryption.key
DEVGUARD_FRONTEND_URL=${DEVGUARD_PROTOCOL}://${DEVGUARD_WEB_DOMAIN}
DEVGUARD_API_URL=${DEVGUARD_PROTOCOL}://${DEVGUARD_API_DOMAIN}
DEPENDENCY_PROXY_CACHE_MAX_SIZE_MB=1024

# SLSA build provenance signing. The key is generated by the guided setup.
SLSA_PRIVATE_KEY_PATH=/keys/slsa-private-key.pem
# OIDC issuers whose CI workload identity tokens are accepted (comma separated).
# Empty accepts every https issuer - the issuer is recorded in the signed provenance and verifiers have to check it.
# SLSA_OIDC_TRUSTED_ISSUERS=https://gitlab.com,https://gitlab.opencode.de
# Audience the tokens have to be issued for. Defaults to DEVGUARD_API_URL and must match devguard_api_url of the CI components.
# SLSA_OIDC_AUDIENCE=
# Rekor transparency log to upload the signed provenance to. Empty does not upload it.
# SLSA_REKOR_URL=https://rekor.sigstore.dev

#######################
# ORY Kratos
#######################
ORY_SDK_URL=http://kratos:4433
ORY_ADMIN_URL=http://kratos:4434


#######################
# PostgreSQL
#######################

POSTGRES_DEVGUARD_USER=postgres
POSTGRES_DEVGUARD_DB=devguard
POSTGRES_HOST=postgresql # this is the docker-compose service name
POSTGRES_PORT=5432
